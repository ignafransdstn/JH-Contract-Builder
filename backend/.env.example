# ================================================================
# JH CONTRACT BUILDER - ENVIRONMENT CONFIGURATION TEMPLATE
# ================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to git (it's in .gitignore)

# ===== Server Configuration =====
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# ===== PostgreSQL Database Configuration =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jh_contract_builder
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# ===== JWT Configuration =====
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRE=30d

# ================================================================
# EMAIL NOTIFICATION CONFIGURATION (Multi-Provider Support)
# ================================================================
# The system automatically detects email provider and uses appropriate SMTP
# Configure only the providers you plan to use

# ===== GMAIL SMTP Configuration =====
# How to get Gmail App Password:
# 1. Go to Google Account (myaccount.google.com)
# 2. Security > 2-Step Verification (enable if not enabled)
# 3. App passwords > Select app: Mail > Select device: Other > Generate
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ===== MICROSOFT 365 / OUTLOOK SMTP Configuration =====
# For M365 Business or Outlook.com accounts
M365_USER=your_email@yourdomain.com
M365_PASSWORD=your_m365_password

# ===== YAHOO SMTP Configuration =====
# How to get Yahoo App Password:
# 1. Go to Yahoo Account Security
# 2. Generate app password
YAHOO_USER=your_yahoo@yahoo.com
YAHOO_APP_PASSWORD=your_yahoo_app_password

# ===== CUSTOM SMTP Server Configuration =====
# For other email providers or self-hosted SMTP
CUSTOM_SMTP_HOST=smtp.example.com
CUSTOM_SMTP_PORT=587
CUSTOM_SMTP_SECURE=false
CUSTOM_SMTP_AUTH=true
CUSTOM_SMTP_USER=your_email@example.com
CUSTOM_SMTP_PASSWORD=your_password

# ===== Default Email Settings (Fallback) =====
EMAIL_FROM=noreply@jimbaranhijau.com
EMAIL_FROM_NAME=JH Contract Builder
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_password

# ===== Microsoft 365 Business Domains =====
# Comma-separated list of M365 business email domains
# Users with these domains will receive Teams personal notifications
# Example: jimbaranhijau.com,subsidiary.com
M365_DOMAINS=jimbaranhijau.com

# ================================================================
# MICROSOFT TEAMS NOTIFICATION CONFIGURATION
# ================================================================

# ===== Teams Channel Webhook (Team Visibility) =====
# How to setup:
# 1. Open Teams > Your channel > ... > Workflows
# 2. Create new workflow > Post to channel when webhook received
# 3. Copy webhook URL
TEAMS_WEBHOOK_URL=your_teams_webhook_url_here
TEAMS_NOTIFICATION_ENABLED=true

# ===== Teams Personal Messaging (M365 Graph API) =====
# For sending direct personal messages to M365 users
# 
# How to setup:
# 1. Go to Azure Portal (portal.azure.com)
# 2. Azure Active Directory > App registrations > New registration
#    Name: JH Contract Builder
#    Supported account types: Single tenant
# 3. Copy these values:
#    Overview > Directory (tenant) ID → M365_TENANT_ID
#    Overview > Application (client) ID → M365_CLIENT_ID
# 4. Certificates & secrets > New client secret
#    Copy secret value → M365_CLIENT_SECRET
# 5. API permissions > Add permission > Microsoft Graph > Application:
#    - Chat.ReadWrite (to send messages)
#    - User.Read.All (to lookup users)
# 6. Grant admin consent for these permissions
# 7. Set M365_GRAPH_ENABLED=true
#
M365_GRAPH_ENABLED=false
M365_TENANT_ID=your_azure_tenant_id
M365_CLIENT_ID=your_azure_app_client_id
M365_CLIENT_SECRET=your_azure_app_client_secret

# ===== OpenAI Configuration (for document scanning) =====
OPENAI_API_KEY=your_openai_api_key_here

# ===== File Upload Configuration =====
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=docx,pdf,xlsx
APP_URL=http://localhost:3000
UPLOAD_PATH=./uploads

# ===== Testing Configuration =====
# Email address to use for testing notifications
TEST_EMAIL=your_test_email@example.com
TEST_M365_EMAIL=your_m365_test_email@yourdomain.com

# ================================================================
# NOTIFICATION BEHAVIOR SUMMARY
# ================================================================
# When a contract approval notification is sent:
# 
# 1. Teams Channel Webhook (Always)
#    - Notification posted to configured Teams channel
#    - Visible to entire team
#    - Requires: TEAMS_WEBHOOK_URL configured
#
# 2. Teams Personal Message (M365 Users Only)
#    - Direct personal chat message in Teams
#    - Only for users with email in M365_DOMAINS
#    - Requires: M365 Graph API configured
#
# 3. Email Notification (Always)
#    - Email sent via detected SMTP provider
#    - Gmail users → Gmail SMTP
#    - M365/Outlook users → M365 SMTP
#    - Yahoo users → Yahoo SMTP
#    - Others → Custom SMTP
#    - Requires: Appropriate SMTP credentials configured
#
# All channels are non-blocking - failure in one doesn't affect others
# ================================================================

